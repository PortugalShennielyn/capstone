                            </div>
                            <div class="form-text">Cannot exceed the purchase order total.</div>
                        </div>
                    </div>
                    <div id="receiveValidationMessage" class="receive-validation-message mb-2" aria-live="polite"></div>
                    <label class="form-label fw-semibold" for="receiveArrivedRemarks">Remarks</label>
                    <textarea id="receiveArrivedRemarks" class="form-control" rows="3" placeholder="Optional receiving notes..."></textarea>
                </div>
                <div class="modal-footer">
