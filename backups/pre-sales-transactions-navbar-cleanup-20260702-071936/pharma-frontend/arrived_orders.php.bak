                <div class="modal-header">
                    <div>
                        <h2 class="modal-title fs-5 fw-bold" id="receiveArrivedOrderModalLabel">Receive Items</h2>
                        <p class="text-muted small mb-0 mt-1">PO <span id="receiveArrivedPoNumber">-</span> · <span id="receiveArrivedSupplierName">-</span></p>
