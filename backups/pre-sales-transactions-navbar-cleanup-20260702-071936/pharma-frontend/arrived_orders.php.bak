                                <div class="payment-summary-line">
                                    <span>Original PO Total</span>
                                    <strong id="receiveOriginalTotal">₱0.00</strong>
                                </div>
                                <div class="payment-summary-line">
                                    <span>Rejected Qty</span>
                                    <strong id="receiveRejectedQty">0 items</strong>
                                </div>
                                <div class="payment-summary-line payment-summary-credit">
                                    <span>Supplier Credit</span>
                                    <strong id="receiveSupplierCredit">-₱0.00</strong>
                                </div>
                                <div class="payment-summary-inputs">
                                    <div>
                                        <label class="form-label small fw-bold mb-1" for="receiveSupplierDiscount">Supplier Discount</label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">₱</span>
                                            <input id="receiveSupplierDiscount" class="form-control" type="number" min="0" step="0.01" value="0" inputmode="decimal">
                                        </div>
                                    </div>
                                </div>
                                <div class="payment-summary-line payment-summary-total">
                                    <span>Final Payment</span>
                                    <strong id="receiveFinalAmount">₱0.00</strong>
