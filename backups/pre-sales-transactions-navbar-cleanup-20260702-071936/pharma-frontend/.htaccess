<IfModule mod_headers.c>
    <FilesMatch "^(arrived_orders|cashier|clerk|complete_delivery|dashboard|expiry_monitoring|inventory|pending_orders|pos|products|purchase_orders|return_damage|supplier)\.php$">
        Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "Thu, 01 Jan 1970 00:00:00 GMT"
    </FilesMatch>
</IfModule>
