# SMTP settings used by both legacy and current mail helpers. Replace placeholders locally.
PHARMA_MAIL_HOST=smtp.example.com
PHARMA_MAIL_PORT=587
PHARMA_MAIL_USERNAME=your-smtp-username
PHARMA_MAIL_PASSWORD=your-smtp-password
PHARMA_MAIL_ENCRYPTION=tls
PHARMA_MAIL_FROM_EMAIL=no-reply@example.com
PHARMA_MAIL_FROM=no-reply@example.com
PHARMA_MAIL_FROM_NAME=Dr. R Pharmacy
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls
PHARMA_APP_URL=http://localhost/pharmacy/pharma-frontend