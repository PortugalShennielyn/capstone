        :root { --sidebar-width:260px; --sidebar-collapsed-width:70px; --sidebar-bg:#1f2530; --sidebar-bg-deep:#171c25; --sidebar-text:#c6ccd8; --sidebar-muted:#8790a1; --purple:#7c3aed; --purple-dark:#6328d6; --body-bg:#f4f6fb; --topbar-height:70px; --border-soft:#e8ecf3; --text-main:#252b37; --transition:all .3s ease; }
        * { box-sizing:border-box; } body { margin:0; min-height:100vh; color:var(--text-main); background:var(--body-bg); font-family:"Inter",sans-serif; } body.dark-mode { --body-bg:#111827; --border-soft:#263244; --text-main:#e5e7eb; } a { text-decoration:none; }
        .app-sidebar { position:fixed; inset:0 auto 0 0; width:var(--sidebar-width); overflow:hidden; color:var(--sidebar-text); background:var(--sidebar-bg); z-index:1040; transition:var(--transition); box-shadow:12px 0 30px rgba(15,23,42,.12); } .app-sidebar.collapsed { width:var(--sidebar-collapsed-width); }
        .sidebar-brand { height:var(--topbar-height); display:flex; align-items:center; padding:0 20px; background:var(--sidebar-bg-deep); } .brand-mark { width:38px; height:38px; display:inline-flex; align-items:center; justify-content:center; border-radius:10px; color:#fff; background:linear-gradient(135deg,var(--purple),#a855f7); }
        .sidebar-nav { height:calc(100vh - var(--topbar-height)); padding:16px 10px 88px; overflow:auto; } .nav-link-item { min-height:46px; display:flex; align-items:center; gap:14px; margin:4px 0; padding:0 16px; color:var(--sidebar-text); border-radius:8px; font-size:14px; font-weight:600; white-space:nowrap; } .nav-link-item:hover,.nav-link-item.active { color:#fff; background:var(--purple); } .nav-link-item i { width:22px; text-align:center; }
        .app-sidebar.collapsed .sidebar-brand,.app-sidebar.collapsed .nav-link-item { justify-content:center; padding-inline:0; } .app-sidebar.collapsed .nav-label,.app-sidebar.collapsed .fa-angle-right,.app-sidebar.collapsed .profile-name,.app-sidebar.collapsed .signout-btn { display:none; }
        .sidebar-profile-footer { position:absolute; inset:auto 0 0; display:flex; align-items:center; justify-content:space-between; padding:15px 20px; background:var(--sidebar-bg-deep); } .avatar-initials { width:35px; height:35px; display:flex; align-items:center; justify-content:center; border-radius:50%; color:#fff; background:var(--purple); font-weight:700; } .profile-name { color:#fff; } .signout-btn { color:var(--sidebar-muted); }
        .main-wrapper { min-height:100vh; margin-left:var(--sidebar-width); transition:var(--transition); } .main-wrapper.collapsed { margin-left:var(--sidebar-collapsed-width); } .topbar { position:sticky; top:0; z-index:1020; height:var(--topbar-height); display:flex; align-items:center; justify-content:space-between; padding:0 26px; background:#fff; border-bottom:1px solid var(--border-soft); } body.dark-mode .topbar,body.dark-mode .card { background:#182131; color:var(--text-main); } .topbar-left,.topbar-right { display:flex; align-items:center; gap:14px; } .icon-btn { width:42px; height:42px; border:0; border-radius:8px; color:#4b5563; background:#f4f6fb; } .page-title-mini { display:flex; flex-direction:column; } .page-title-mini span { color:#7b8494; font-size:12px; font-weight:600; } .page-body { padding:28px; } .card { border:1px solid var(--border-soft); border-radius:8px; box-shadow:0 10px 28px rgba(15,23,42,.05); } .btn-purple { --bs-btn-color:#fff; --bs-btn-bg:var(--purple); --bs-btn-border-color:var(--purple); --bs-btn-hover-bg:var(--purple-dark); --bs-btn-hover-border-color:var(--purple-dark); }
        .supplier-table-scroll { max-height:clamp(280px,52vh,520px)!important; overflow:auto!important; position:relative; border-radius:10px; }
        #table-suppliers,
        #table-supplier-products { border-collapse:separate!important; border-spacing:0!important; margin-bottom:0!important; }
        #table-suppliers thead th,
        #table-supplier-products thead th { position:sticky!important; top:0!important; z-index:30!important; background:#f8f9fc!important; box-shadow:inset 0 -1px 0 #d8dee9!important; }
        #table-supplier-products thead th:last-child { z-index:40!important; }
        .supplier-product-actions { display:inline-flex; align-items:center; justify-content:center; gap:6px; white-space:nowrap; }
        .supplier-product-actions .btn { width:32px; height:32px; min-width:32px; display:inline-flex; align-items:center; justify-content:center; padding:0; }
        .supplier-product-toolbar { display:grid; grid-template-columns:minmax(240px,1.4fr) repeat(4,minmax(150px,1fr)); gap:10px; margin-bottom:14px; align-items:end; }
        .supplier-product-toolbar .form-label { margin-bottom:5px; color:#667085; font-size:11px; font-weight:850; text-transform:uppercase; }
        .supplier-product-toolbar .form-control,
        .supplier-product-toolbar .form-select { min-height:38px; font-size:13px; font-weight:700; }
        .supplier-product-table { width:max-content; min-width:1660px; table-layout:auto; border-collapse:separate; border-spacing:0; }
        .supplier-product-table th { color:#596274; background:#f8f9fc; font-size:12px; font-weight:800; white-space:nowrap; text-align:center; vertical-align:middle; }
        .supplier-product-table td { color:var(--text-main); font-size:12.5px; font-weight:700; vertical-align:middle; text-align:center; overflow-wrap:break-word; word-break:normal; white-space:normal; }
        .supplier-product-table .col-supplier { min-width:170px; max-width:220px; text-align:left; }
        .supplier-product-table .col-brand { min-width:140px; max-width:190px; text-align:left; }
        .supplier-product-table .col-product { min-width:200px; max-width:270px; text-align:left; }
        .supplier-product-table .col-variant { min-width:190px; max-width:260px; text-align:left; }
        .supplier-product-table .col-price { min-width:115px; text-align:right; white-space:nowrap; }
        .supplier-product-table .col-package { min-width:135px; max-width:165px; }
        .supplier-product-table .col-contains { min-width:185px; max-width:240px; text-align:center; }
        .supplier-product-table th:last-child,
        .supplier-product-table td:last-child { position:sticky; right:0; z-index:5; min-width:96px; background:var(--bs-table-bg,#fff); border-left:1px solid #e5e9f1; box-shadow:-6px 0 10px rgba(15,23,42,.06); }
        .supplier-product-table th:last-child { z-index:7; background:#f8f9fc; }
        .supplier-product-name { display:grid; gap:2px; line-height:1.25; }
        .supplier-product-name strong { font-size:.88rem; font-weight:850; }
        .supplier-product-edit-dialog,
        .supplier-product-dialog { --drp-modal-width:min(1180px,calc(100vw - 32px)); --drp-modal-max-width:min(1180px,calc(100vw - 32px)); --drp-modal-min-width:720px; --drp-modal-min-height:620px; width:min(1180px,calc(100vw - 32px)); max-width:min(1180px,calc(100vw - 32px)); margin-inline:auto; }
        .supplier-product-dialog .modal-content,
