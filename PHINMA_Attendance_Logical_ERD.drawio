<mxCell id="d" value="&lt;div style=&quot;text-align:center;font-size:16px;font-weight:bold;color:#fff;background:#2563EB;padding:7px;&quot;&gt;DEPARTMENT&lt;/div&gt;&lt;div style=&quot;padding:7px;line-height:1.6;&quot;&gt;&lt;b&gt;PK&lt;/b&gt; department_id&lt;br/&gt;department_name [UQ]&lt;/div&gt;" style="whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="80" y="180" width="240" height="120" as="geometry"/></mxCell>
<mxCell id="s" value="&lt;div style=&quot;text-align:center;font-size:16px;font-weight:bold;color:#fff;background:#7C3AED;padding:7px;&quot;&gt;STAFF_FACULTY&lt;/div&gt;&lt;div style=&quot;padding:7px;line-height:1.42;&quot;&gt;&lt;b&gt;PK&lt;/b&gt; staff_faculty_id&lt;br/&gt;employee_number [UQ]&lt;br/&gt;first_name&lt;br/&gt;last_name&lt;br/&gt;email [UQ]&lt;br/&gt;&lt;b&gt;FK&lt;/b&gt; department_id&lt;br/&gt;staff_type (Staff | Faculty)&lt;br/&gt;position_title [optional]&lt;br/&gt;is_admin&lt;/div&gt;" style="whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="400" y="120" width="270" height="270" as="geometry"/></mxCell>
